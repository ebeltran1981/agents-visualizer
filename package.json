{
  "name": "agents-visualizer",
  "productName": "Agents Visualizer",
  "version": "0.1.0",
  "description": "Live dashboard of one coding-agent session",
  "author": "Edwin Beltran",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.github.ebeltran1981.agents-visualizer",
    "productName": "Agents Visualizer",
    "artifactName": "agents-visualizer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "aggregate.js",
      "markdown.js",
      "index.html",
      "harnesses/**",
      "electron/main.js",
      "electron/icon.png",
      "package.json"
    ],
    "icon": "electron/icon.png",
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "agents-visualizer-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "agents-visualizer-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
